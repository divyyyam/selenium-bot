# Dedicated test GitHub account (2FA disabled). Copy to .env and fill in.
GITHUB_USERNAME=
GITHUB_PASSWORD=

# Run Chrome without a window (default: false, so the run is visible on video)
HEADLESS=false

# End-to-end tests (npm run test:e2e)
# E2E=1 runs the suite against the account above. It creates and deletes one private repo.
E2E=
# E2E_NEGATIVE=1 also tries a wrong password.
E2E_NEGATIVE=

# Enables API checks and API cleanup. Without it, cleanup goes through the browser.
GITHUB_TOKEN=

